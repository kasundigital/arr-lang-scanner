# arr-lang-scanner Docker settings
# New installs can configure login, Sonarr and Radarr entirely from the web UI.

ARR_PORT=8100
REQUEST_TIMEOUT=60

# Optional bootstrap/migration values. Leave blank for first-run browser setup.
ARR_USERNAME=
ARR_PASSWORD=
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
