# arr-lang-scanner Docker settings
# Copy this file to .env and fill in the values.

ARR_PORT=8100
ARR_USERNAME=admin
ARR_PASSWORD=replace-with-a-strong-password
# ARR_TOKEN is optional; the app securely generates one at startup if omitted.
ARR_TOKEN=

# If Sonarr/Radarr run on the same Linux Docker host, these defaults work with docker-compose.yml.
SONARR_URL=http://host.docker.internal:8989
SONARR_API_KEY=
RADARR_URL=http://host.docker.internal:7878
RADARR_API_KEY=

REQUEST_TIMEOUT=60
